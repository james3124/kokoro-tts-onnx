# Copy to .env for local testing (never commit .env)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_BUCKET=audio

# Model paths — warmup.py downloads these automatically if missing
MODEL_PATH=./models/kokoro-v1.0.int8.onnx
VOICES_PATH=./models/voices-v1.0.bin

# ONNX Runtime threads (1 = safest for single-core; increase if you have more cores)
ORT_THREADS=1

# Voice & language defaults (overridable per-request too)
DEFAULT_VOICE=af_heart
LANG_CODE=a
